# Example environment configuration file
# Copy this to .env and fill in your credentials

# ===========================================
# LLM Model Configuration (Provider Auto-Detected)
# ===========================================

# Provider is automatically detected from model name:
# - azure/deployment-name -> Azure OpenAI
# - bedrock/model-id → Amazon Bedrock
# - claude-model-name → Anthropic Claude

# Examples:
# MODEL=azure/your-deployment-name                              # Azure OpenAI deployment
MODEL=claude-3-5-sonnet-20241022                                    # Anthropic Claude
# MODEL=bedrock/us.anthropic.claude-3-5-sonnet-20241022-v2:0        # Amazon Bedrock



# ===========================================
# Amazon Bedrock Credentials (for Bedrock models)
# ===========================================

# Recommended: Use AWS Profile (more secure)
# AWS_PROFILE=your-aws-profile-name

# Alternative: Use IAM role (for EC2/ECS/Lambda)
# AWS_REGION=us-east-1


# ===========================================
# Anthropic API Credentials (for Anthropic models)
# ===========================================

# ANTHROPIC_API_KEY=your_anthropic_api_key_here


# ===========================================
# Azure OpenAI Credentials (for Azure models)
# ===========================================

# Compatible with the direct Azure OpenAI SDK convention.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# VISION_MODEL=your-deployment-name
# AZURE_OPENAI_API_VERSION=2024-10-21

# LiteLLM-style names and MODEL=azure/deployment-name are also supported.



# ===========================================
# Application Configuration (optional)
# ===========================================

# DEBUG=false
# MAX_TOKENS=8192
# TEMPERATURE=0.1
# TIMEOUT_SECONDS=300

# ===========================================
# Directory Configuration (optional)
# ===========================================

# TEMP_DIR=./temp
# TEMPLATES_DIR=./templates
# OUTPUT_DIR=./output 

# ===========================================
# Transfer Service Configuration (required for the OCR Transfer API)
# ===========================================

# Database, JWT validation, and outbound host allow-list are required.
# TRANSFER_DATABASE_PATH=./data/transfer.sqlite3
# TRANSFER_JWT_ISSUER=https://issuer.example.com/
# TRANSFER_JWT_AUDIENCE=ocr-transfer
# TRANSFER_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# TRANSFER_ALLOWED_HOSTS=["localhost","127.0.0.1"]
# Payload, worker, and rate limits are required; tune them for the deployment.
# TRANSFER_WORKER_POLL_SECONDS=1
# TRANSFER_WORKER_ENABLED=true
# TRANSFER_MAX_ATTEMPTS=5
# TRANSFER_MAX_PAYLOAD_BYTES=1048576
# TRANSFER_IDEMPOTENCY_RETENTION_HOURS=24
# TRANSFER_PAYLOAD_RETENTION_DAYS=30
# TRANSFER_AUDIT_RETENTION_DAYS=90
# TRANSFER_REQUESTS_PER_MINUTE=120
# TRANSFER_BURST=20
# The resolver JSON must contain the connector credential refs and the
# encrypted data key ref. Header values are non-secret configuration values.
# TRANSFER_CREDENTIALS_JSON={"vault://connectors/invoice-target":{"auth":"REPLACE_WITH_TARGET_SECRET"},"config://headers/target-api-version":{"value":"2026-01-01"},"key://transfer/data":"REPLACE_WITH_FERNET_KEY"}
# TRANSFER_DATA_ENCRYPTION_KEY_REF=key://transfer/data

# Credential bundles are selected by connector credential_ref. Use token for
# bearer auth, username/password for Basic auth, and client_id/client_secret
# for OAuth2 client credentials. Keep these values in a secret manager or a
# protected local environment; never put them in OCR examples or mappings.
# TRANSFER_TEST_TOKEN=REPLACE_WITH_AN_ALREADY_ISSUED_JWT