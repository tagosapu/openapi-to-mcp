{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openapi-to-mcp.local/schemas/ocr-transfer-v1.json",
  "title": "OCR Transfer Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document",
    "ocr",
    "delivery",
    "metadata"
  ],
  "properties": {
    "schema_version": {
      "const": "ocr-transfer/v1",
      "type": "string"
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "ocr": {
      "$ref": "#/$defs/ocr"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(?:|/(?:[^/~]|~0|~1)*)+$"
    },
    "opaqueRef": {
      "type": "string",
      "pattern": "^object://[A-Za-z0-9._-]+(?:/[A-Za-z0-9._~!$&'()*+,;=:@%-]+)+$"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "minimum": 0.0,
        "maximum": 1.0
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "polygon": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number",
              "minimum": 0.0,
              "maximum": 1.0
            }
          }
        }
      },
      "additionalProperties": true
    },
    "fieldValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value_type",
        "status"
      ],
      "properties": {
        "raw_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true,
        "value_type": {
          "type": "string",
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "date",
            "datetime",
            "currency",
            "object",
            "array"
          ]
        },
        "unit": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "status": {
          "type": "string",
          "enum": [
            "extracted",
            "missing",
            "ambiguous",
            "invalid",
            "manually_corrected"
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "string"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "integer"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "number"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "boolean"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "date"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "datetime"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "currency"
              }
            }
          },
          "then": {
            "required": [
              "value",
              "unit"
            ],
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "object"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "array"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "documentContent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "type": "string",
          "minLength": 1
        },
        "filename": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[A-Fa-f0-9]{64}$"
        },
        "storage_ref": {
          "$ref": "#/$defs/opaqueRef"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "document_type",
        "source_system"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "type": "string",
          "minLength": 1
        },
        "source_system": {
          "type": "string",
          "minLength": 1
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "content": {
          "$ref": "#/$defs/documentContent"
        }
      }
    },
    "ocr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "languages": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "text_ref": {
          "$ref": "#/$defs/opaqueRef"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/fieldValue"
          }
        },
        "line_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/fieldValue"
                }
              }
            }
          }
        }
      },
      "anyOf": [
        {
          "required": [
            "fields"
          ]
        },
        {
          "required": [
            "line_items"
          ]
        }
      ]
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector_id",
        "mapping_id",
        "operation",
        "deduplication_key_path"
      ],
      "properties": {
        "connector_id": {
          "type": "string",
          "minLength": 1
        },
        "mapping_id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "upsert"
          ]
        },
        "deduplication_key_path": {
          "$ref": "#/$defs/jsonPointer"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "correlation_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}